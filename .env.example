# ==============================================================================
# Klick - Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` and adjust the variables to your local setup.

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60.0

# Mock Site & Dashboard URLs
MOCK_SITE_URL=http://localhost:8080
DASHBOARD_PORT=8000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Agent Execution Limits
MAX_AGENT_STEPS=15
STEP_TIMEOUT_SECONDS=30.0

# Browser Automation Settings (Playwright)
HEADLESS_BROWSER=false
BROWSER_SLOW_MO_MS=0
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

# Public Web Navigation
BROWSERPILOT_ALLOW_EXTERNAL=true

# Safety & Guardrail Settings
SAFETY_STRICT_MODE=true
BLOCK_DESTRUCTIVE_ACTIONS=true

# Logging
LOG_LEVEL=INFO
